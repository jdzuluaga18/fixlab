<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.demoapp.controller.ReparacionesController"
            stylesheets="@../css/dashboard.css"
            style="-fx-background-color:#0d1117;">
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
            <Label fx:id="lblReloj" text="00:00:00" styleClass="topbar-clock"/>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane styleClass="topbar-avatar">
                <Label fx:id="lblUsuario" text="USER" styleClass="topbar-avatar-label"/>
            </StackPane>
        </HBox>
    </top>
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <Label text="FixLab" styleClass="sidebar-logo"/>
            <Label text="Taller de reparaciones" styleClass="sidebar-subtitle"/>
            <Region style="-fx-background-color:#21262d;-fx-pref-height:1px;-fx-min-height:1px;"/>
            <Label text="NAVEGACIÓN" styleClass="sidebar-section"/>
            <Button text="🏠  Dashboard"    onAction="#irDashboard"    styleClass="sidebar-btn"/>
            <Button text="👤  Clientes"     onAction="#irClientes"     styleClass="sidebar-btn"/>
            <Button text="🔧  Reparaciones" onAction="#irReparaciones" styleClass="sidebar-btn sidebar-btn-active"/>
            <Button text="📅  Agenda"       onAction="#irAgenda"       styleClass="sidebar-btn"/>
            <Button text="🧾  Presupuestos" onAction="#irPresupuestos" styleClass="sidebar-btn"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Region style="-fx-background-color:#21262d;-fx-pref-height:1px;-fx-min-height:1px;"/>
            <Button text="⏻  Cerrar sesión" onAction="#onLogout" styleClass="btn-logout"/>
        </VBox>
    </left>
    <center>
        <VBox styleClass="content-area" spacing="20">

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Reparaciones" styleClass="page-title"/>
                    <Label text="Gestión de órdenes de reparación" styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Nueva reparación" onAction="#onNuevaReparacion" styleClass="btn-primary"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="campoBusqueda"
                           promptText="🔍  Buscar por dispositivo..."
                           onKeyReleased="#onBuscar"
                           styleClass="search-field" prefWidth="260" minWidth="180"/>
                <ComboBox fx:id="filtroEstado" promptText="Filtrar por estado"
                          onAction="#onFiltrarEstado" styleClass="combo-field"
                          prefWidth="190" minWidth="150"/>
                <Button text="Ver todas" onAction="#onVerTodas" styleClass="btn-secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" text="0 reparaciones" styleClass="count-label"/>
            </HBox>

            <TableView fx:id="tablaReparaciones" VBox.vgrow="ALWAYS"
                       >
                <columns>
                    <TableColumn fx:id="colId"           text="ID"         minWidth="55"  maxWidth="70"/>
                    <TableColumn fx:id="colCliente"      text="Cliente"    minWidth="140"/>
                    <TableColumn fx:id="colDispositivo"  text="Dispositivo" minWidth="130"/>
                    <TableColumn fx:id="colEstado"       text="Estado"     minWidth="140" maxWidth="180"/>
                    <TableColumn fx:id="colFechaEntrada" text="Entrada"    minWidth="90"  maxWidth="120"/>
                    <TableColumn fx:id="colFechaSalida"  text="Salida"     minWidth="90"  maxWidth="120"/>
                    <TableColumn fx:id="colAcciones"     text="Acciones"   minWidth="90"  maxWidth="110"/>
                </columns>
                <placeholder>
                    <Label text="No hay reparaciones registradas" styleClass="page-subtitle"/>
                </placeholder>
            </TableView>

        </VBox>
    </center>
</BorderPane>
