<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.demoapp.controller.FormularioCitaController"
      stylesheets="@../css/dashboard.css"
      spacing="14" prefWidth="440"
      style="-fx-background-color: #0d1117; -fx-padding: 28px;">
    <Label fx:id="lblTitulo" text="Nueva cita" styleClass="modal-title"/>
    <Label text="Rellena los datos de la cita" styleClass="modal-subtitle"/>
    <Region prefHeight="4"/>
    <HBox spacing="12">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Fecha *" styleClass="field-label"/>
            <DatePicker fx:id="campoFecha" maxWidth="Infinity" styleClass="combo-field"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Hora * (HH:mm)" styleClass="field-label"/>
            <TextField fx:id="campoHora" promptText="09:30" styleClass="input-field" maxWidth="Infinity"/>
        </VBox>
    </HBox>
    <VBox spacing="5">
        <Label text="Descripción *" styleClass="field-label"/>
        <TextArea fx:id="campoDescripcion" promptText="Motivo de la cita..." prefRowCount="3" wrapText="true"
                  style="-fx-background-color: #161b22; -fx-text-fill: #c9d1d9; -fx-prompt-text-fill: #3d444d;
                         -fx-border-color: #21262d; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 9px 12px;"/>
    </VBox>
    <VBox spacing="5">
        <Label text="Cliente (opcional)" styleClass="field-label"/>
        <ComboBox fx:id="comboCliente" promptText="Sin cliente asociado" maxWidth="Infinity" styleClass="combo-field"/>
    </VBox>
    <Label fx:id="lblError" text="" wrapText="true" styleClass="error-label"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-secondary"/>
        <Button text="Guardar" onAction="#onGuardar" styleClass="btn-primary"/>
    </HBox>
</VBox>
